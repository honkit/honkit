{
  "name": "@honkit/e2e",
  "version": "6.3.0",
  "private": true,
  "description": "End-to-end tests for HonKit: build books with honkit and check the output in a browser",
  "license": "Apache-2.0",
  "author": "azu",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:build": "node scripts/build-fixtures.mjs",
    "test:e2e:server": "node scripts/serve-static.mjs",
    "test:e2e:setup": "playwright install --with-deps chromium",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.7.4",
    "honkit": "workspace:*",
    "typescript": "^5.6.2"
  }
}
